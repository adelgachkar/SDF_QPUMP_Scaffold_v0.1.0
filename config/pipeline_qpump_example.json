{
  "version": "0.1.0",
  "description": "QPUMP Closed Boundary Pipeline with Delta5 Metric Coupling",
  "nodes": {
    "cavity": {
      "type": "cavity_resonator",
      "params": {
        "damping": 1.0,
        "coupling": 1.0
      }
    },
    "pump": {
      "type": "peristaltic_pump",
      "params": {
        "gain": 1.0
      }
    },
    "bridge": {
      "type": "berry_torque_bridge",
      "params": {
        "coupling": 0.5
      }
    },
    "stress": {
      "type": "boundary_stress_integrator",
      "params": {
        "area": 2.0,
        "topological_deficit_delta5_rad": 0.1284
      }
    },
    "metric": {
      "type": "effective_metric_source",
      "params": {
        "scale": 1.0,
        "radial_distance": 1.0
      }
    }
  },
  "edges": [
    {
      "from_node": "cavity",
      "from_port": "cavity_intensity",
      "to_node": "pump",
      "to_port": "amplitude"
    },
    {
      "from_node": "pump",
      "from_port": "pump_thrust",
      "to_node": "bridge",
      "to_port": "phase_rate"
    },
    {
      "from_node": "bridge",
      "from_port": "berry_torque",
      "to_node": "stress",
      "to_port": "jet_power"
    },
    {
      "from_node": "stress",
      "from_port": "stress_tensor_4x4",
      "to_node": "metric",
      "to_port": "stress_tensor_4x4"
    }
  ]
}
